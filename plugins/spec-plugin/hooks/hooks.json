{
  "description": "Spec-driven開発のフック群。計画中のAutoCompact対策、図表の強制、計画モードガードなど。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-planning-writes.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-requirements.sh\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-planning-writes.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-requirements.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/auto-allow-spec-commands.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-planning-writes.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-diagrams.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-code-examples.sh\""
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-diagrams.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/enforce-code-examples.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'files=$(find .plugin-workspace/.specs -name PLANNING 2>/dev/null); if [ -n \"$files\" ]; then echo \"\\n=== SPEC-DRIVEN PLANNING IN PROGRESS ===\\n\" >&2; for f in $files; do dir=$(dirname \"$f\"); echo \"Planning: ${dir##*/}\" >&2; done; echo \"\\nDO NOT IMPLEMENT CODE.\\nContinue planning and spec creation only.\\nAsk user before transitioning to implementation.\\n\" >&2; fi; exit 0'"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-phase-name.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -d .plugin-workspace/.specs ] || exit 0; moved=0; for dir in .plugin-workspace/.specs/[0-9][0-9][0-9]-*/; do [ -d \"$dir\" ] || continue; [ -f \"${dir}PLANNING\" ] && continue; mkdir -p .plugin-workspace/.specs/archive && mv \"$dir\" .plugin-workspace/.specs/archive/ && moved=$((moved+1)); done; [ $moved -gt 0 ] && echo \"Archived $moved completed spec(s) to .plugin-workspace/.specs/archive/\" >&2; exit 0'"
          }
        ]
      }
    ]
  }
}
